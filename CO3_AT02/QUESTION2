import pandas as pd
import matplotlib.pyplot as plt

from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA, FactorAnalysis, FastICA
from sklearn.mixture import GaussianMixture


data = pd.read_csv(r"C:\Users\shaik\OneDrive\Desktop\machine learning2\chemical.csv")

print("Original Dataset:")
print(data)

X = data[[
    "Alcohol",
    "MalicAcid",
    "Ash",
    "Alcalinity",
    "Magnesium",
    "Phenols"
]]

scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

print("\nStandardized Data:")
print(X_scaled)
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X_scaled)

print("\nPCA Result:")
print(X_pca)

print("\nPCA Explained Variance:")
print(pca.explained_variance_ratio_)



fa = FactorAnalysis(n_components=2, random_state=42)
X_fa = fa.fit_transform(X_scaled)

print("\nFactor Analysis Result:")
print(X_fa)


ica = FastICA(n_components=2, random_state=42)
X_ica = ica.fit_transform(X_scaled)

print("\nICA Result:")
print(X_ica)
gmm = GaussianMixture(
    n_components=3,
    random_state=42
)

clusters = gmm.fit_predict(X_pca)

data["Cluster"] = clusters

print("\nGMM Clustering Result:")
print(data[["Sample", "Cluster"]])
plt.scatter(
    X_pca[:, 0],
    X_pca[:, 1],
    c=clusters,
    cmap="viridis",
    s=100
)

plt.xlabel("PCA Component 1")
plt.ylabel("PCA Component 2")
plt.title("Gaussian Mixture Model Clustering using PCA")
plt.colorbar(label="Cluster")

plt.show()
plt.figure(figsize=(12, 4))

plt.subplot(1, 3, 1)
plt.scatter(X_pca[:, 0], X_pca[:, 1])
plt.title("PCA")
plt.xlabel("Component 1")
plt.ylabel("Component 2")

plt.subplot(1, 3, 2)
plt.scatter(X_fa[:, 0], X_fa[:, 1])
plt.title("Factor Analysis")
plt.xlabel("Factor 1")
plt.ylabel("Factor 2")
plt.subplot(1, 3, 3)
plt.scatter(X_ica[:, 0], X_ica[:, 1])
plt.title("ICA")
plt.xlabel("IC 1")
plt.ylabel("IC 2")

plt.tight_layout()
plt.show()
