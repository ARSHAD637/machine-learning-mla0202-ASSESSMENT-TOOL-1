import numpy as np


image = np.array([
    [10, 12, 11, 10],
    [12, 80, 13, 11],
    [10, 14, 90, 12],
    [11, 13, 12, 10]
])

print("Original Image:")
print(image)

updated = image.copy()

for i in range(1, image.shape[0] - 1):
    for j in range(1, image.shape[1] - 1):


        neighbors = [
            image[i-1][j],
            image[i+1][j],
            image[i][j-1],
            image[i][j+1]
        ]

      
        updated[i][j] = int(np.mean(neighbors))

print("\nUpdated Image:")
print(updated)
