from sklearn.linear_model import LinearRegression
X = [
    [800, 2, 5],
    [1000, 3, 7],
    [1200, 3, 8],
    [1500, 4, 9],
    [900, 2, 6]
]

y = [15000, 22000, 26000, 35000, 18000]

model = LinearRegression()
model.fit(X, y)

new_house = [[1100, 3, 8]]
rent = model.predict(new_house)

print("Predicted Rent:", rent[0])
