import random
N = 10000

on_time = 0

for i in range(N):

    traffic = random.choice(["Low", "Medium", "High"])

    if traffic == "Low":
        delivery_time = random.randint(20, 40)
    elif traffic == "Medium":
        delivery_time = random.randint(30, 60)
    else:
        delivery_time = random.randint(50, 90)

    if delivery_time <= 60:
        on_time += 1

probability = on_time / N

print("Total Simulations:", N)
print("On-Time Deliveries:", on_time)
print("Estimated Probability:", probability)
print("Estimated Percentage:", probability * 100, "%")
