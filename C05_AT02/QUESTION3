grid = [
    [0, 0, 0],
    [0, -1, 0],
    [0, 0, 1]
]
rows = 3
cols = 3

gamma = 0.9
threshold = 0.001

actions = [
    (-1, 0),   # Up
    (1, 0),    # Down
    (0, -1),   # Left
    (0, 1)     # Right
]

V = [[0 for j in range(cols)] for i in range(rows)]

while True:

    new_V = [row[:] for row in V]
    delta = 0

    for i in range(rows):
        for j in range(cols):
            if grid[i][j] == -1:
                continue
            if grid[i][j] == 1:
                continue

            best_value = float("-inf")

            for action in actions:

                ni = i + action[0]
                nj = j + action[1]
                if (
                    0 <= ni < rows
                    and 0 <= nj < cols
                    and grid[ni][nj] != -1
                ):


                    if grid[ni][nj] == 1:
                        reward = 10
                    else:
                        reward = -1

                    value = reward + gamma * V[ni][nj]

                    best_value = max(
                        best_value,
                        value
                    )

            new_V[i][j] = best_value

            delta = max(
                delta,
                abs(new_V[i][j] - V[i][j])
            )

    V = new_V

    if delta < threshold:
        break

policy = [
    [" " for j in range(cols)]
    for i in range(rows)
]

symbols = {
    (-1, 0): "↑",
    (1, 0): "↓",
    (0, -1): "←",
    (0, 1): "→"
}

for i in range(rows):
    for j in range(cols):

        if grid[i][j] == -1:
            policy[i][j] = "X"

        elif grid[i][j] == 1:
            policy[i][j] = "G"

        else:

            best_value = float("-inf")
            best_action = None

            for action in actions:

                ni = i + action[0]
                nj = j + action[1]

                if (
                    0 <= ni < rows
                    and 0 <= nj < cols
                    and grid[ni][nj] != -1
                ):

                    reward = 10 if grid[ni][nj] == 1 else -1

                    value = reward + gamma * V[ni][nj]

                    if value > best_value:
                        best_value = value
                        best_action = action

            policy[i][j] = symbols[best_action]

print("Value Function:")

for row in V:
    print(row)

print("\nOptimal Policy:")

for row in policy:
    print(row)
